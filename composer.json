{
    "name": "sailex234/rag-php",
    "description": "A from-scratch Retrieval-Augmented Generation (RAG) pipeline in PHP, using a local Ollama LLM and pgvector for semantic search.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.9",
        "vlucas/phpdotenv": "^5.6",
        "opis/json-schema": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
