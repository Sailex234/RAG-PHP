# No external API keys — everything runs locally.
# Ollama (runs in Docker; these are currently informational, code defaults match them)
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Postgres / pgvector connection
DB_HOST=localhost
DB_PORT=5436
DB_NAME=rag_db
DB_USER=rag_user
DB_PASS=rag_pass
